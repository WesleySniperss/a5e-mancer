{{!-- Level Up Dialog --}}
{{!-- One level, as the build page and the level-up page draw it --}}
{{#*inline "luLevelCard"}}
  <section id="lu-build-L{{this.charLevel}}"
           class="lu-section lu-build-level {{#if this.future}}lu-build-future{{/if}} {{#if this.focus}}lu-build-focus{{/if}}">
    <header class="lu-build-head">
      <span class="lu-level-n">{{this.charLevel}}</span>
      <span class="lu-build-title">{{this.title}}</span>
      {{#if this.hp}}
        <span class="lu-build-hp" data-tooltip="{{localize 'am.build.hp-tip'}}"><i class="fa-solid fa-heart"></i> {{this.hp}}</span>
      {{/if}}
      {{#if (and this.future this.planOptions)}}
        <select class="lu-plan-class {{#if this.planned}}lu-plan-set{{/if}}" data-level="{{this.charLevel}}"
                data-tooltip="{{localize 'am.build.plan-class'}}" aria-label="{{localize 'am.build.plan-class'}}">
          <optgroup label="{{localize 'am.build.your-classes'}}">
            {{#each this.planOptions.owned}}<option value="{{this.key}}" {{#if (eq this.key ../planKey)}}selected{{/if}}>{{this.name}}</option>{{/each}}
          </optgroup>
          {{#if this.planOptions.fresh.length}}
          <optgroup label="{{localize 'am.build.new-class'}}">
            {{#each this.planOptions.fresh}}<option value="{{this.key}}" {{#if (eq this.key ../planKey)}}selected{{/if}}>{{this.name}}{{#unless this.meets}} ✗{{/unless}}</option>{{/each}}
          </optgroup>
          {{/if}}
        </select>
      {{/if}}
      <span class="lu-build-actions">
        {{#if this.isNext}}
          <button type="button" class="lu-build-act lu-build-levelup" data-action="luLevelUpNow" data-class-id="{{this.classId}}">
            <i class="fa-solid fa-arrow-up"></i> {{localize 'am.build.level-up'}}
          </button>
        {{/if}}
        {{#if this.canRebuild}}
          <button type="button" class="lu-build-act" data-action="luRebuildFrom" data-level="{{this.charLevel}}"
                  data-tooltip="{{localize 'am.levels.rebuild' n=this.charLevel}}" aria-label="{{localize 'am.levels.rebuild' n=this.charLevel}}">
            <i class="fa-solid fa-rotate"></i>
          </button>
        {{/if}}
        {{#if this.canRemoveAbove}}
          <button type="button" class="lu-build-act" data-action="luRemoveAbove" data-level="{{this.charLevel}}"
                  data-tooltip="{{localize 'am.levels.remove-above' n=this.charLevel}}" aria-label="{{localize 'am.levels.remove-above' n=this.charLevel}}">
            <i class="fa-solid fa-arrow-down"></i>
          </button>
        {{/if}}
      </span>
    </header>

    {{#if this.prereqFail}}
      <p class="lu-build-note lu-build-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize 'am.build.prereq' req=this.prereqFail}}</p>
    {{/if}}
    {{#if this.pending}}
      <p class="am-hint"><i class="fas fa-spinner fa-spin"></i> {{localize 'am.build.reading'}}</p>
    {{/if}}

    {{#if this.features.length}}
      <div class="lu-build-chips">
        {{#each this.features}}
          <span class="lu-build-chip {{#if this.missing}}lu-build-missing{{/if}}" data-uuid="{{this.uuid}}" data-name="{{this.name}}"
                {{#if this.missing}}data-tooltip="{{localize 'am.build.missing'}}"{{/if}}>
            {{#if this.img}}<img src="{{this.img}}" alt="">{{/if}}{{this.name}}
          </span>
        {{/each}}
      </div>
    {{/if}}

    {{#if this.origins.length}}
      <div class="lu-build-chips lu-build-origins">
        <span class="lu-build-picks-label">{{localize 'am.build.origins'}}:</span>
        {{#each this.origins}}
          <span class="lu-build-chip" data-uuid="{{this.uuid}}" data-name="{{this.name}}">
            {{#if this.img}}<img src="{{this.img}}" alt="">{{/if}}{{this.name}}
          </span>
        {{/each}}
      </div>
    {{/if}}

    {{#each this.choices}}{{> luChoice}}{{/each}}

    {{#if this.benefits.length}}
      <ul class="lu-down-benefits">
        {{#each this.benefits}}
          <li>{{#if this.source}}<strong>{{this.source}}</strong> · {{/if}}{{this.text}}</li>
        {{/each}}
      </ul>
    {{/if}}

    {{#each this.notes}}
      <p class="lu-build-note"><i class="fa-solid fa-wand-sparkles"></i> {{this}}</p>
    {{/each}}

    {{#if this.picks.length}}
      <div class="lu-build-chips lu-build-picks">
        <span class="lu-build-picks-label">{{localize 'am.levels.picked'}}:</span>
        {{#each this.picks}}
          <span class="lu-build-chip" data-uuid="{{this.uuid}}" data-name="{{this.name}}">
            {{#if this.img}}<img src="{{this.img}}" alt="">{{/if}}{{this.name}}
          </span>
        {{/each}}
      </div>
    {{/if}}

    {{#if this.empty}}<p class="am-hint">{{localize 'am.build.nothing'}}</p>{{/if}}
  </section>
{{/inline}}
{{!-- The levels still ahead, under the level being taken: each with the class
      planned for it, which a player can change level by level --}}
{{#*inline "luAhead"}}
  {{#unless levelCards.noAhead}}
  <hr />
  <section class="lu-section lu-build-more lu-ahead">
    {{#if levelCards.showFuture}}
      {{#if levelCards.loading}}
        <p class="am-hint"><i class="fas fa-spinner fa-spin"></i> {{localize 'am.build.loading'}}</p>
      {{/if}}
      <div class="lu-ahead-list">
        {{#each levelCards.ahead}}
          {{#if this.firstFuture}}
            <div class="lu-build-divider"><span>{{localize 'am.build.ahead'}}</span></div>
            {{#if ../levelCards.planOptions}}<p class="am-hint lu-plan-hint">{{localize 'am.build.plan-hint'}}</p>{{/if}}
          {{/if}}
          {{> luLevelCard planOptions=../levelCards.planOptions}}
        {{/each}}
      </div>
      {{#if levelCards.planned}}
        <button type="button" class="lu-build-toggle" data-action="luResetPlan">
          <i class="fa-solid fa-rotate-left"></i> {{localize 'am.build.reset-plan'}}
        </button>
      {{/if}}
      <button type="button" class="lu-build-toggle" data-action="luToggleFuture">
        <i class="fa-solid fa-eye-slash"></i> {{localize 'am.build.hide-future'}}
      </button>
    {{else if levelCards.atCap}}
      <p class="am-hint">{{localize 'am.build.at-cap'}}</p>
    {{else}}
      <button type="button" class="lu-build-toggle" data-action="luToggleFuture">
        <i class="fa-solid fa-eye"></i> {{localize 'am.build.show-future'}}
      </button>
      <p class="am-hint">{{localize 'am.build.future-hint'}}</p>
    {{/if}}
  </section>
  {{/unless}}
{{/inline}}
{{!-- One choice a level asks: the options, or the one taken --}}
{{#*inline "luChoice"}}
      <div class="lu-build-choice {{#if this.unrecorded}}lu-build-unrecorded{{/if}}">
        <span class="lu-build-choice-label">
          <i class="fa-solid {{#if this.resolved}}fa-check{{else}}fa-list-check{{/if}}"></i> {{this.label}}{{#unless this.resolved}} · {{localize 'am.build.choose' n=this.count}}{{/unless}}{{#if this.asi}} · {{localize 'am.build.or-feat'}}{{/if}}{{#if this.unrecorded}} · {{localize 'am.build.unrecorded'}}{{/if}}
        </span>
        <div class="lu-build-chips">
          {{#each this.options}}
            <span class="lu-build-chip {{#unless ../resolved}}lu-build-option{{/unless}}" {{#if this.uuid}}data-uuid="{{this.uuid}}"{{/if}} data-name="{{this.name}}">
              {{#if this.img}}<img src="{{this.img}}" alt="">{{/if}}{{this.name}}
            </span>
          {{/each}}
        </div>
      </div>
{{/inline}}
<div class="am-levelup-content lu-with-levels">

  {{!-- The character's levels, as Level Up Gateway's builder lists them: a
        click on a past level shows what it gave and lets the build be redone
        from there; the last entry is the next level, the level-up itself. --}}
  <nav class="lu-levels" aria-label="{{localize 'am.levels.title'}}">
    <button type="button" class="lu-levels-title" data-action="luShowBuild" data-tooltip="{{localize 'am.build.open'}}">
      <i class="fa-solid fa-route"></i> {{localize 'am.levels.title'}}
    </button>
    {{#each levelList}}
      <button type="button"
              class="lu-level {{#if this.active}}lu-level-active{{/if}} {{#if this.going}}lu-level-going{{/if}}"
              data-action="luShowLevel" data-level="{{this.charLevel}}"
              data-tooltip="{{localize 'am.levels.level-tip' n=this.charLevel}}">
        <span class="lu-level-n">{{this.charLevel}}</span>
        <span class="lu-level-name">{{this.label}}</span>
      </button>
    {{/each}}
    <button type="button" class="lu-level lu-level-next {{#if levelNext.active}}lu-level-active{{/if}}"
            data-action="luShowNext">
      <span class="lu-level-n"><i class="fa-solid fa-plus"></i></span>
      <span class="lu-level-name">{{localize 'am.levels.next' n=levelNext.charLevel}}</span>
    </button>
    {{#each levelQueued}}
      <div class="lu-level lu-level-queued" data-tooltip="{{localize 'am.levels.queued'}}">
        <span class="lu-level-n">{{this.charLevel}}</span>
        <span class="lu-level-name">{{this.label}}</span>
      </div>
    {{/each}}
  </nav>

  <div class="lu-main">

  {{!-- A run of levels in progress: a rebuild, or "up to level N" --}}
  {{#if levelQueue}}
  <section class="lu-section lu-queue">
    <i class="fa-solid fa-route"></i>
    <span>
      {{#if levelQueue.rebuild}}
        {{localize 'am.levels.queue-rebuild' at=levelQueue.at until=levelQueue.until}}
      {{else}}
        {{localize 'am.levels.queue-up' at=levelQueue.at until=levelQueue.until}}
      {{/if}}
    </span>
    <button type="button" class="lu-queue-stop" data-action="luStopQueue">{{localize 'am.levels.queue-stop'}}</button>
  </section>
  {{/if}}

  {{!-- Mode Toggle: what to do with the next level. Not shown on a past level. --}}
  {{#unless (eq mode 'build')}}
  <section class="lu-section lu-mode-section">
    <div class="lu-mode-toggle">
      <button type="button" class="lu-mode-btn {{#if (eq mode 'levelup')}}lu-mode-active{{/if}}" data-mode="levelup">
        <i class="fa-solid fa-arrow-up"></i>
        {{localize 'am.levelup.mode-levelup'}}
      </button>
      <button type="button" class="lu-mode-btn {{#if (eq mode 'multiclass')}}lu-mode-active{{/if}}" data-mode="multiclass">
        <i class="fa-solid fa-code-branch"></i>
        {{localize 'am.levelup.mode-multiclass'}}
      </button>
      <button type="button" class="lu-mode-btn lu-mode-down {{#if (and (eq mode 'leveldown') (not down.byLevel))}}lu-mode-active{{/if}}" data-mode="leveldown">
        <i class="fa-solid fa-arrow-down"></i>
        {{localize 'am.levelup.mode-leveldown'}}
      </button>
    </div>
  </section>

  <hr />
  {{/unless}}

  {{!-- ═══════════════════════════════════════════════════════ THE BUILD
        Every level the character has and what it gave, all at once, as D&D
        Beyond lists a class's levels; under them a button for the levels
        ahead, with the features and choices each will bring - for planning,
        or just to see what is coming. Right-click a chip for its text. --}}
  {{#if (eq mode 'build')}}
  <section class="lu-section lu-build-intro">
    <h3><i class="fa-solid fa-route"></i> {{localize 'am.build.title'}}</h3>
    <p class="am-hint">{{localize 'am.build.hint'}}</p>
    {{#if build.reading}}
      <p class="am-hint"><i class="fas fa-spinner fa-spin"></i> {{localize 'am.build.reading'}}</p>
    {{/if}}
  </section>

  {{#each build.levels}}
  {{#if this.firstFuture}}
    <div class="lu-build-divider"><span>{{localize 'am.build.ahead'}}</span></div>
    {{#if ../build.planOptions}}<p class="am-hint lu-plan-hint">{{localize 'am.build.plan-hint'}}</p>{{/if}}
  {{/if}}
  {{> luLevelCard planOptions=../build.planOptions}}
  {{/each}}

  <section class="lu-section lu-build-more">
    {{#if build.showFuture}}
      {{#if build.planned}}
        <button type="button" class="lu-build-toggle" data-action="luResetPlan">
          <i class="fa-solid fa-rotate-left"></i> {{localize 'am.build.reset-plan'}}
        </button>
      {{/if}}
      {{#if build.loading}}
        <p class="am-hint"><i class="fas fa-spinner fa-spin"></i> {{localize 'am.build.loading'}}</p>
      {{/if}}
      <button type="button" class="lu-build-toggle" data-action="luToggleFuture">
        <i class="fa-solid fa-eye-slash"></i> {{localize 'am.build.hide-future'}}
      </button>
    {{else if build.atCap}}
      <p class="am-hint">{{localize 'am.build.at-cap'}}</p>
    {{else}}
      <button type="button" class="lu-build-toggle" data-action="luToggleFuture">
        <i class="fa-solid fa-eye"></i> {{localize 'am.build.show-future'}}
      </button>
      <p class="am-hint">{{localize 'am.build.future-hint'}}</p>
    {{/if}}
  </section>

  {{!-- ═══════════════════════════════════════════════════════ LEVEL-DOWN MODE
        A class back down to a lower level, or the character down to a
        character level from the list. What a5e removes with the levels is
        listed and locked; the picks it does not track - maneuvers, spells, a
        feat taken for an ASI - are rows to keep or remove, with the plan's
        suggestion marked. See LevelDownService. --}}
  {{else if (eq mode 'leveldown')}}

  {{#if downNothing}}
  <section class="lu-section">
    <h3><i class="fa-solid fa-arrow-down"></i> {{localize 'am.leveldown.title'}}</h3>
    <p class="am-hint"><i class="fa-solid fa-circle-info"></i> {{localize 'am.leveldown.nothing'}}</p>
  </section>
  {{else}}
  <section class="lu-section">
    {{#if down.rebuild}}
      <h3><i class="fa-solid fa-rotate"></i> {{localize 'am.levels.rebuild' n=down.rebuildFrom}}</h3>
      <p class="am-hint">{{localize 'am.levels.rebuild-intro' from=down.rebuildFrom to=down.charBefore}}</p>
    {{else if down.byLevel}}
      <h3><i class="fa-solid fa-arrow-down"></i> {{localize 'am.levels.remove-above' n=down.charTarget}}</h3>
      <p class="am-hint">{{localize 'am.leveldown.hint'}}</p>
    {{else}}
      <h3><i class="fa-solid fa-arrow-down"></i> {{localize 'am.leveldown.title'}}</h3>
      <p class="am-hint">{{localize 'am.leveldown.hint'}}</p>

      {{#if multiclass}}
        <div class="form-row flex items-center gap-sm mb-sm">
          <label for="lu-down-class-select">{{localize 'am.levelup.class-label'}}</label>
          <select id="lu-down-class-select" class="form-select">
            {{#each down.classes}}
              <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>
                {{this.name}} ({{localize 'am.levelup.level'}} {{this.level}})
              </option>
            {{/each}}
          </select>
        </div>
      {{/if}}
      <div class="form-row flex items-center gap-sm mb-sm">
        <label for="lu-down-target">{{localize 'am.leveldown.to-level'}}</label>
        <select id="lu-down-target" class="form-select">
          {{#each down.targets}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
    {{/if}}

    <div class="lu-level-badge flex items-center gap-sm">
      {{#each down.sections}}
        <span class="lu-badge">
          {{this.className}}: {{this.current}} → {{#if this.removesClass}}—{{else}}{{this.target}}{{/if}}
        </span>
      {{/each}}
      <span class="lu-badge">{{localize 'am.levelup.total-level'}}: {{down.charBefore}} → {{down.charAfter}}</span>
      {{#if down.hpDrop}}
        <span class="lu-badge lu-badge-red" data-tooltip="{{localize 'am.leveldown.hp-hint'}}">
          <i class="fa-solid fa-heart"></i> {{down.hp.before}} → {{down.hp.after}}
        </span>
      {{/if}}
    </div>
  </section>

  {{#each down.sections}}
  <hr />
  <section class="lu-section lu-down-section">
    <h3>
      <i class="fa-solid fa-box-archive"></i> {{localize 'am.leveldown.goes-title'}}
      {{#if (gt ../down.sections.length 1)}}<span class="lu-down-class">{{this.className}}</span>{{/if}}
    </h3>
    <p class="am-hint">{{localize 'am.leveldown.goes-hint'}}</p>
    {{#if this.features.length}}
      <div class="am-replace-list">
        {{#each this.features}}
          <div class="am-replace-row am-replace-marked lu-down-fixed" data-uuid="{{this.uuid}}">
            <img src="{{this.img}}" alt="" class="am-replace-img">
            <span class="am-replace-name">{{this.name}}</span>
            <i class="fa-solid fa-lock"></i>
          </div>
        {{/each}}
      </div>
    {{/if}}
    {{#if this.benefits.length}}
      <ul class="lu-down-benefits">
        {{#each this.benefits}}
          <li><span class="lu-down-lvl">{{this.level}}</span>{{#if this.source}}<strong>{{this.source}}</strong> · {{/if}}{{this.text}}</li>
        {{/each}}
      </ul>
    {{/if}}
    {{#if this.guardArchetype}}
      <p class="am-hint"><i class="fa-solid fa-shield-halved"></i> {{localize 'am.leveldown.archetype-kept' name=this.archetype.name}}</p>
    {{/if}}
    {{#if this.empty}}
      <p class="am-hint">{{localize 'am.leveldown.goes-none'}}</p>
    {{/if}}
  </section>
  {{/each}}

  {{#each down.groups}}
  <hr />
  <section class="lu-section lu-down-section" data-group="{{this.key}}">
    <h3>
      <i class="fa-solid fa-hand-pointer"></i> {{this.title}}
      <span class="am-counter-badge {{#if this.short}}am-badge-pending{{else}}am-badge-success{{/if}}">
        {{localize 'am.leveldown.removing' n=this.removing}}
      </span>
    </h3>
    {{#if this.note}}<p class="am-hint">{{this.note}}</p>{{/if}}
    {{#if @first}}<p class="am-hint">{{localize 'am.leveldown.row-hint'}}</p>{{/if}}
    <div class="am-replace-list">
      {{#each this.items}}
        <button type="button"
                class="am-replace-row {{#if this.removing}}am-replace-marked{{/if}} {{#if this.forced}}lu-down-forced{{/if}}"
                data-action="luDownToggle" data-item-id="{{this.id}}" data-forced="{{this.forced}}"
                data-uuid="{{this.uuid}}"
                {{#if this.forced}}data-tooltip="{{localize 'am.leveldown.forced'}}"{{/if}}>
          <img src="{{this.img}}" alt="" class="am-replace-img">
          <span class="am-replace-name">{{this.name}}</span>
          {{#if this.note}}<span class="am-hint">{{this.note}}</span>{{/if}}
          <i class="fa-solid {{#if this.forced}}fa-lock{{else if this.removing}}fa-rotate-left{{else}}fa-xmark{{/if}}"></i>
        </button>
      {{/each}}
    </div>
  </section>
  {{/each}}

  <hr />
  <section class="lu-section">
    <label class="lu-down-backup">
      <input type="checkbox" id="lu-down-backup" {{#if down.backup}}checked{{/if}} />
      {{localize 'am.leveldown.backup'}}
    </label>
  </section>
  {{/if}}{{!-- /downNothing --}}

  {{!-- ═══════════════════════════════════════════════════════ MULTICLASS MODE --}}
  {{else if (eq mode 'multiclass')}}

  {{!-- The levels the character has, with what each gave - the class's own
        features as well as what a5e recorded. Folds away; remembered. --}}
  {{#if levelCards.past.length}}
  <section class="lu-section lu-past-levels">
    <button type="button" class="am-replace-toggle lu-past-toggle" data-action="luTogglePast">
      <i class="fa-solid {{#if levelCards.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
      <i class="fa-solid fa-route"></i> {{localize 'am.build.your-levels' n=levelCards.past.length}}
      {{#if levelCards.reading}}<i class="fas fa-spinner fa-spin lu-past-spin" data-tooltip="{{localize 'am.build.reading'}}"></i>{{/if}}
    </button>
    {{#unless levelCards.collapsed}}
      <div class="lu-past-list">
        {{#each levelCards.past}}{{> luLevelCard}}{{/each}}
      </div>
    {{/unless}}
  </section>
  {{/if}}

  <section class="lu-section">
    <h3><i class="fa-solid fa-code-branch"></i> {{localize 'am.levelup.multiclass-title'}}</h3>
    <p class="am-hint">{{localize 'am.levelup.multiclass-hint'}}</p>

    {{#if availableClasses.length}}
      <div class="form-row flex items-center gap-sm mb-sm">
        <label for="lu-new-class-select">{{localize 'am.levelup.multiclass-class-label'}}</label>
        <select id="lu-new-class-select" name="newClassUuid" class="form-select">
          <option value="">{{localize 'am.levelup.multiclass-class-placeholder'}}</option>
          {{#each availableClasses}}
            <option value="{{this.uuid}}" {{#if (eq this.uuid ../newClass.uuid)}}selected{{/if}}>
              {{this.name}} (d{{this.hitDie}}){{#unless this.prereqs.meets}} ✗{{/unless}}
            </option>
          {{/each}}
        </select>
      </div>

      {{#if newClass}}
        {{#if newClass.prereqs.meets}}
          <p class="lu-prereq lu-prereq-ok">
            <i class="fa-solid fa-circle-check"></i>
            {{localize 'am.levelup.multiclass-prereqs-ok'}}
          </p>
        {{else}}
          <p class="lu-prereq lu-prereq-fail">
            <i class="fa-solid fa-triangle-exclamation"></i>
            {{localize 'am.levelup.multiclass-prereqs-fail'}}: <strong>{{newClass.prereqs.missingText}}</strong>
          </p>
        {{/if}}
      {{/if}}
    {{else}}
      <p class="am-hint"><i class="fa-solid fa-circle-info"></i> {{localize 'am.levelup.multiclass-none-available'}}</p>
    {{/if}}

    <div class="lu-level-badge flex items-center gap-sm">
      <span class="lu-badge">
        {{localize 'am.levelup.total-level'}}: {{newTotalLevel}}
      </span>
    </div>
  </section>

  {{#if newClass}}
  <hr />

  {{!-- What a SECOND class owes, which is less than a first one. Shown before
        the player commits: a5e's window afterwards lists only what survives,
        with nothing to say it was ever narrower. --}}
  <section class="lu-section">
    <h3><i class="fa-solid fa-scale-unbalanced"></i> {{localize 'am.levelup.mc-prof-title'}}</h3>
    <p class="am-hint">{{localize 'am.levelup.mc-prof-hint'}}</p>
    {{#if mcProficiencies.lines.length}}
      <ul class="lu-mc-prof">
        {{#each mcProficiencies.lines}}
          <li><i class="fa-solid fa-check"></i> {{this}}</li>
        {{/each}}
      </ul>
    {{else}}
      <p class="am-hint">{{localize 'am.levelup.mc-prof-none'}}</p>
    {{/if}}

    {{#if mcProficiencies.hasLosses}}
      <p class="am-hint lu-mc-prof-note">{{localize 'am.levelup.mc-prof-lost-title'}}</p>
      <ul class="lu-mc-prof lu-mc-prof-lost">
        {{#each mcProficiencies.lost}}
          <li><i class="fa-solid fa-xmark"></i> {{this}}</li>
        {{/each}}
        {{#if mcProficiencies.lostEquipment}}
          <li><i class="fa-solid fa-xmark"></i> {{localize 'am.levelup.mc-prof-lost-equipment'}}</li>
        {{/if}}
      </ul>
    {{/if}}

    {{!-- A class with no entry in the table still gets the universal rules, so
          the lists above are real — it is only the per-class slice we cannot
          apply, and the player has to check that one by hand. --}}
    {{#unless mcProficiencies.known}}
      <p class="am-hint lu-mc-prof-note lu-mc-prof-warn">
        <i class="fa-solid fa-triangle-exclamation"></i> {{localize 'am.levelup.mc-prof-unknown'}}
      </p>
    {{/unless}}

    <p class="am-hint lu-mc-prof-note">
      <i class="fa-solid fa-circle-info"></i> {{localize 'am.levelup.mc-prof-denied'}}
    </p>
  </section>

  <hr />

  {{!-- HP: a5e's own grant dialog asks for this and only its answer counts —
        hp.max is derived from the class item's hp.levels whenever class HP
        automation is on, which it is as soon as the actor has a class. --}}
  {{#unless deferHp}}
  <section class="lu-section">
    <h3><i class="fa-solid fa-heart"></i> {{localize 'am.levelup.hp-title'}} (d{{newClass.hitDie}})</h3>
    <p class="am-hint">{{localize 'am.levelup.con-mod'}}: {{#if (gte conMod 0)}}+{{/if}}{{conMod}}</p>

    <div class="lu-hp-methods">
      <label class="lu-hp-method {{#if (eq hpMethod 'average')}}lu-selected{{/if}}">
        <input type="radio" name="hp-method" value="average" {{#if (eq hpMethod 'average')}}checked{{/if}} />
        <div class="lu-method-content">
          <span class="lu-method-title">{{localize 'am.levelup.hp-average'}}</span>
          <span class="lu-method-value">{{avgHP}} HP</span>
        </div>
      </label>
      <label class="lu-hp-method {{#if (eq hpMethod 'roll')}}lu-selected{{/if}}">
        <input type="radio" name="hp-method" value="roll" {{#if (eq hpMethod 'roll')}}checked{{/if}} />
        <div class="lu-method-content">
          <span class="lu-method-title">{{localize 'am.levelup.hp-roll'}}</span>
          <div class="flex items-center gap-sm">
            <button type="button" data-action="rollHP" class="lu-roll-btn">
              <i class="fa-solid fa-dice-d{{newClass.hitDie}}"></i>
              {{localize 'am.levelup.roll'}}
            </button>
            <span id="lu-roll-result" class="lu-roll-result">
              {{#if rolledHP}}{{rolledHP}} HP{{else}}—{{/if}}
            </span>
          </div>
        </div>
      </label>
      <label class="lu-hp-method {{#if (eq hpMethod 'max')}}lu-selected{{/if}}">
        <input type="radio" name="hp-method" value="max" {{#if (eq hpMethod 'max')}}checked{{/if}} />
        <div class="lu-method-content">
          <span class="lu-method-title">{{localize 'am.levelup.hp-max'}}</span>
          <span class="lu-method-value">{{newClass.hitDie}} + {{conMod}} CON HP</span>
        </div>
      </label>
      <label class="lu-hp-method {{#if (eq hpMethod 'manual')}}lu-selected{{/if}}">
        <input type="radio" name="hp-method" value="manual" {{#if (eq hpMethod 'manual')}}checked{{/if}} />
        <div class="lu-method-content">
          <span class="lu-method-title">{{localize 'am.levelup.hp-manual'}}</span>
          <input id="lu-manual-hp" type="number" name="manualHP"
            class="form-input lu-manual-input" min="1" placeholder="?" value="{{manualHP}}"
            {{#unless (eq hpMethod 'manual')}}disabled{{/unless}} />
        </div>
      </label>
    </div>
  </section>
  {{/unless}}

  {{!-- Maneuvers (multiclass): a section per kind taught - combat traditions and
        magic schools apart. See partial-maneuver-picker.hbs. --}}
  {{#if maneuverInfo.newManeuversToLearn}}
    {{#each maneuverSections}}{{> am-maneuver-picker}}{{/each}}
  {{/if}}

  {{!-- Spells (multiclass) --}}
  {{#if spellInfo}}
  {{> am-spell-browser}}
  {{/if}}

  {{!-- Only worth saying when a5e really will ask. When the builder took the
        grants over, the choices are already on this page and promising a window
        that never opens just makes the player wait for one. --}}
  {{#unless hasBgGrants}}
  <hr />
  <section class="lu-section lu-grants-note">
    <p class="am-hint">
      <i class="fa-solid fa-circle-info"></i>
      {{#if grantsAbsorbed}}
        {{localize 'am.levelup.features-here'}}
      {{else}}
        {{localize 'am.levelup.features-note-multiclass'}}
      {{/if}}
    </p>
  </section>
  {{/unless}}

  {{/if}}{{!-- /newClass --}}

  {{> luAhead}}

  {{!-- ═══════════════════════════════════════════════════ LEVEL-UP MODE --}}
  {{else}}

  {{!-- The levels the character has, with what each gave - the class's own
        features as well as what a5e recorded. Folds away; remembered. --}}
  {{#if levelCards.past.length}}
  <section class="lu-section lu-past-levels">
    <button type="button" class="am-replace-toggle lu-past-toggle" data-action="luTogglePast">
      <i class="fa-solid {{#if levelCards.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
      <i class="fa-solid fa-route"></i> {{localize 'am.build.your-levels' n=levelCards.past.length}}
      {{#if levelCards.reading}}<i class="fas fa-spinner fa-spin lu-past-spin" data-tooltip="{{localize 'am.build.reading'}}"></i>{{/if}}
    </button>
    {{#unless levelCards.collapsed}}
      <div class="lu-past-list">
        {{#each levelCards.past}}{{> luLevelCard}}{{/each}}
      </div>
    {{/unless}}
  </section>
  {{/if}}

  {{!-- Class selector --}}
  <section class="lu-section">
    <h3><i class="fa-solid fa-chess-rook"></i> {{localize 'am.levelup.choose-class'}}</h3>

    {{#if (gt classes.length 1)}}
      <div class="form-row flex items-center gap-sm mb-sm">
        <label for="lu-class-select">{{localize 'am.levelup.class-label'}}</label>
        <select id="lu-class-select" name="classId" class="form-select">
          {{#each classes}}
            <option value="{{this.id}}" {{#if (eq this.id ../selectedClass.id)}}selected{{/if}}>
              {{this.name}} ({{localize 'am.levelup.level'}} {{this.level}})
            </option>
          {{/each}}
        </select>
      </div>
    {{else}}
      <p>
        <strong>{{selectedClass.name}}</strong>
        {{localize 'am.levelup.current-level'}}: {{selectedClass.level}}
        → <strong>{{newClassLevel}}</strong>
      </p>
    {{/if}}

    <div class="lu-level-badge flex items-center gap-sm">
      <span class="lu-badge">
        {{localize 'am.levelup.total-level'}}: {{newTotalLevel}}
      </span>
      {{#if upToOptions.length}}
        <label class="lu-up-to" data-tooltip="{{localize 'am.levels.up-to-hint'}}">
          {{localize 'am.levels.up-to'}}
          <select id="lu-up-to">
            {{#each upToOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.value}}</option>{{/each}}
          </select>
        </label>
      {{/if}}
      {{#if info.gainsASI}}
        <span class="lu-badge lu-badge-gold">
          <i class="fa-solid fa-star"></i> {{localize 'am.levelup.gains-asi'}}
        </span>
      {{/if}}
      {{#if info.gainsKnack}}
        <span class="lu-badge lu-badge-blue">
          <i class="fa-solid fa-compass"></i> {{localize 'am.levelup.gains-knack'}}
        </span>
      {{/if}}
    </div>
  </section>

  <hr />

  {{!-- HP: see the multiclass block above — a5e owns this value --}}
  {{#unless deferHp}}
  <section class="lu-section">
    <h3><i class="fa-solid fa-heart"></i> {{localize 'am.levelup.hp-title'}} (d{{selectedClass.hitDie}})</h3>
    <p class="am-hint">{{localize 'am.levelup.con-mod'}}: {{#if (gte conMod 0)}}+{{/if}}{{conMod}}</p>

    <div class="lu-hp-methods">
      <label class="lu-hp-method {{#if (eq hpMethod 'average')}}lu-selected{{/if}}">
        <input type="radio" name="hp-method" value="average" {{#if (eq hpMethod 'average')}}checked{{/if}} />
        <div class="lu-method-content">
          <span class="lu-method-title">{{localize 'am.levelup.hp-average'}}</span>
          <span class="lu-method-value">{{avgHP}} HP</span>
        </div>
      </label>
      <label class="lu-hp-method {{#if (eq hpMethod 'roll')}}lu-selected{{/if}}">
        <input type="radio" name="hp-method" value="roll" {{#if (eq hpMethod 'roll')}}checked{{/if}} />
        <div class="lu-method-content">
          <span class="lu-method-title">{{localize 'am.levelup.hp-roll'}}</span>
          <div class="flex items-center gap-sm">
            <button type="button" data-action="rollHP" class="lu-roll-btn">
              <i class="fa-solid fa-dice-d{{selectedClass.hitDie}}"></i>
              {{localize 'am.levelup.roll'}}
            </button>
            <span id="lu-roll-result" class="lu-roll-result">
              {{#if rolledHP}}{{rolledHP}} HP{{else}}—{{/if}}
            </span>
          </div>
        </div>
      </label>
      <label class="lu-hp-method {{#if (eq hpMethod 'max')}}lu-selected{{/if}}">
        <input type="radio" name="hp-method" value="max" {{#if (eq hpMethod 'max')}}checked{{/if}} />
        <div class="lu-method-content">
          <span class="lu-method-title">{{localize 'am.levelup.hp-max'}}</span>
          <span class="lu-method-value">{{selectedClass.hitDie}} + {{conMod}} CON HP</span>
        </div>
      </label>
      <label class="lu-hp-method {{#if (eq hpMethod 'manual')}}lu-selected{{/if}}">
        <input type="radio" name="hp-method" value="manual" {{#if (eq hpMethod 'manual')}}checked{{/if}} />
        <div class="lu-method-content">
          <span class="lu-method-title">{{localize 'am.levelup.hp-manual'}}</span>
          <input id="lu-manual-hp" type="number" name="manualHP"
            class="form-input lu-manual-input" min="1" placeholder="?"
            {{#unless (eq hpMethod 'manual')}}disabled{{/unless}} />
        </div>
      </label>
    </div>
  </section>
  {{/unless}}


  {{!-- Archetype, at the level the class allows it. a5e asked for this at the end
        of its grant routine; that routine is suppressed, so it is asked here. --}}
  {{#if archetypeChoices}}
  <hr />
  <section class="lu-section">
    <h3><i class="fa-solid fa-sitemap"></i> {{localize 'am.levelup.archetype-title'}}</h3>
    <p class="am-hint">
      {{#if archetypeSkipped}}
        <i class="fa-solid fa-circle-check" style="color:#4a9a4a"></i>
        {{localize 'am.levelup.archetype-none-chosen'}}
      {{else if archetypeUnset}}
        <i class="fa-solid fa-circle-info" style="color:var(--am-gold)"></i>
        {{localize 'am.levelup.archetype-optional'}}
      {{else}}
        {{localize 'am.levelup.archetype-chosen'}} <strong>{{archetypeName}}</strong>
      {{/if}}
    </p>
    <div class="am-card-grid am-inline-card-grid" role="list">
      {{#each archetypeChoices}}
        <button type="button"
                class="am-card {{#if this.selected}}am-card-selected{{/if}}"
                role="listitem"
                data-action="luSelectArchetype"
                data-uuid="{{this.uuid}}"
                data-name="{{this.name}}"
                data-tooltip="{{this.name}}">
          <img class="am-card-img" src="{{this.img}}" alt="" loading="lazy">
          <span class="am-card-name">{{this.name}}</span>
        </button>
      {{/each}}

      {{!-- Going without one is a real choice, not an oversight --}}
      <button type="button"
              class="am-card am-card-none {{#if archetypeSkipped}}am-card-selected{{/if}}"
              role="listitem"
              data-action="luSelectArchetype"
              data-skip="1"
              data-tooltip="{{localize 'am.levelup.archetype-none-hint'}}">
        <i class="fa-solid fa-ban am-card-none-icon"></i>
        <span class="am-card-name">{{localize 'am.levelup.archetype-none'}}</span>
      </button>
    </div>
  </section>
  {{/if}}

  {{!-- Trading in what you already know. A5e lets a maneuver class swap one
        maneuver per class level, and a known caster swap one spell — which is why
        a level that grants nothing new can still be worth opening. Each item
        marked here frees one pick in the browsers above. --}}
  {{!-- Collapsed by default. Swapping something out is the rare case, and a full
        list of everything known pushed the actual choices off the screen. --}}
  {{!-- One trade-in list per kind: a magic maneuver is swapped for a magic
        one, a combat maneuver for a combat one, each with its own count. --}}
  {{#each maneuverReplaceSections}}
  <hr />
  <section class="lu-section am-replace-section" data-kind="{{this.kind}}">
    <button type="button" class="am-replace-toggle" data-action="luToggleReplace" data-what="maneuver" data-kind="{{this.kind}}">
      <i class="fa-solid {{#if this.show}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
      <i class="fa-solid fa-right-left"></i>
      {{this.title}}
      <span class="am-hint">({{this.used}}/{{this.limit}})</span>
    </button>
    {{#if this.show}}
      <p class="am-hint">{{localize 'am.levelup.replace-hint' n=this.limit}}</p>
      <div class="am-replace-list">
        {{#each this.list}}
          <button type="button"
                  class="am-replace-row {{#if this.replaced}}am-replace-marked{{/if}}"
                  data-action="luReplaceManeuver" data-item-id="{{this.id}}"
                  {{#if this.uuid}}data-uuid="{{this.uuid}}"{{/if}} data-name="{{this.name}}" data-img="{{this.img}}">
            <img src="{{this.img}}" alt="" class="am-replace-img">
            <span class="am-replace-name">{{this.name}}</span>
            <span class="am-hint">{{this.traditionLabel}} · {{this.degree}}°</span>
            <i class="fa-solid {{#if this.replaced}}fa-rotate-left{{else}}fa-xmark{{/if}}"></i>
          </button>
        {{/each}}
      </div>
    {{/if}}
  </section>
  {{/each}}

  {{#if knownSpellList}}
  <hr />
  <section class="lu-section am-replace-section">
    <button type="button" class="am-replace-toggle" data-action="luToggleReplace" data-what="spell">
      <i class="fa-solid {{#if showReplaceSpell}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
      <i class="fa-solid fa-right-left"></i>
      {{localize 'am.levelup.replace-spell-title'}}
      <span class="am-hint">({{spellReplaceUsed}}/{{spellReplaceLimit}})</span>
    </button>
    {{#if showReplaceSpell}}
      <p class="am-hint">{{localize 'am.levelup.replace-hint' n=spellReplaceLimit}}</p>
      <div class="am-replace-list">
        {{#each knownSpellList}}
          <button type="button"
                  class="am-replace-row {{#if this.replaced}}am-replace-marked{{/if}}"
                  data-action="luReplaceSpell" data-item-id="{{this.id}}">
            <img src="{{this.img}}" alt="" class="am-replace-img">
            <span class="am-replace-name">{{this.name}}</span>
            <span class="am-hint">{{localize 'am.spells.level-n' n=this.level}}</span>
            <i class="fa-solid {{#if this.replaced}}fa-rotate-left{{else}}fa-xmark{{/if}}"></i>
          </button>
        {{/each}}
      </div>
    {{/if}}
  </section>
  {{/if}}

  {{!-- Ability score increase, or a feat instead. a5e carries only the two
        ability points, so the alternative is offered here. --}}
  {{#if hasAsi}}
  <hr />
  <section class="lu-section">
    <h3><i class="fa-solid fa-arrow-trend-up"></i> {{localize 'am.asi.title'}}</h3>

    <div class="lu-mode-toggle am-asi-toggle">
      <button type="button" class="lu-mode-btn {{#if (eq asiMode 'ability')}}lu-mode-active{{/if}}"
        data-action="luSetAsiMode" data-mode="ability">
        <i class="fa-solid fa-dumbbell"></i> {{localize 'am.asi.mode-ability' n=asiPoints}}
      </button>
      <button type="button" class="lu-mode-btn {{#if (eq asiMode 'feat')}}lu-mode-active{{/if}}"
        data-action="luSetAsiMode" data-mode="feat">
        <i class="fa-solid fa-star"></i> {{localize 'am.asi.mode-feat'}}
      </button>
    </div>

    {{#if (eq asiMode 'ability')}}
      <div class="am-selection-header">
        <div class="am-counter-badge {{#if (gte asiChosen asiPoints)}}am-badge-success{{else}}am-badge-pending{{/if}}">
          {{asiChosen}}/{{asiPoints}}
        </div>
      </div>
      {{#each asiGrants}}
        <div class="am-grant-block">
          <div class="am-grant-head">
            <span class="am-grant-label">{{this.label}}</span>
            <span class="am-counter-badge {{#if this.complete}}am-badge-success{{else}}am-badge-pending{{/if}}">
              {{this.chosen}}/{{this.total}}
            </span>
          </div>
          <div class="am-filter-pills">
            {{#each this.options}}
              <button type="button"
                class="am-filter-pill {{#if this.selected}}am-pill-active{{/if}}"
                data-action="toggleGrantOption"
                data-grant-source="levelup"
                data-grant-id="{{../id}}"
                data-key="{{this.key}}">{{this.label}}</button>
            {{/each}}
          </div>
        </div>
      {{/each}}
    {{else}}
      {{#if featError}}
        <p class="am-hint">{{localize 'am.asi.feat-error'}}</p>
      {{else}}
        <div class="am-selection-header am-feat-controls">
          <input type="text" class="am-feat-search form-input"
            placeholder="{{localize 'am.asi.feat-search'}}" value="{{featSearch}}" autocomplete="off">
          <button type="button"
            class="am-filter-pill {{#if featOnlyEligible}}am-pill-active{{/if}}"
            data-action="luToggleFeatEligible"
            data-tooltip="{{localize 'am.asi.feat-eligible-hint'}}">
            <i class="fa-solid fa-filter"></i> {{localize 'am.asi.feat-eligible-only'}}
          </button>
          <button type="button"
            class="am-filter-pill {{#if featMyClassOnly}}am-pill-active{{/if}}"
            data-action="luToggleFeatMyClass"
            data-tooltip="{{localize 'am.asi.feat-my-class-hint'}}">
            <i class="fa-solid fa-shield-halved"></i> {{localize 'am.asi.feat-my-class'}}
          </button>
          <button type="button"
            class="am-filter-pill {{#if featUngatedOnly}}am-pill-active{{/if}}"
            data-action="luToggleFeatUngated"
            data-tooltip="{{localize 'am.asi.feat-ungated-hint'}}">
            <i class="fa-solid fa-door-open"></i> {{localize 'am.asi.feat-ungated'}}
          </button>
        </div>
        {{#if featUnchecked}}
          <p class="am-hint am-feat-unchecked">{{localize 'am.asi.feat-unchecked-hidden' count=featUnchecked}}</p>
        {{/if}}

        {{!-- Six hundred feats in one alphabetical column is a list you
              scroll, not one you use. These are the orders the service knows;
              clicking the one in force reverses it. --}}
        <div class="am-feat-sorts">
          <span class="am-hint">{{localize 'am.app.sort-label'}}:</span>
          {{#each featSorts}}
            <button type="button" class="am-sort-btn {{#if this.active}}am-active{{/if}}"
              data-action="luFeatSort" data-sort="{{this.key}}">
              {{localize this.label}}
              {{#if this.active}}
                <i class="fa-solid {{#if (eq ../featSortDir 'asc')}}fa-arrow-up{{else}}fa-arrow-down{{/if}}"></i>
              {{/if}}
            </button>
          {{/each}}
        </div>

        {{#if featChosen}}
          <p class="am-hint"><i class="fa-solid fa-circle-check" style="color:#4a9a4a"></i>
            {{localize 'am.asi.feat-chosen'}} <strong>{{featChosen.name}}</strong></p>

          {{!-- What the feat itself asks for — most often the ability point that
                comes with it. Shown here rather than in a section further down,
                because it belongs to the feat just picked. --}}
          {{#if hasFeatGrants}}
            <div class="am-feat-grants">
              <p class="am-hint">{{localize 'am.asi.feat-grants'}}</p>
              {{#each featGrants}}
                <div class="am-grant-block">
                  <div class="am-grant-head">
                    <span class="am-grant-label">{{this.label}}</span>
                    <span class="am-counter-badge {{#if this.complete}}am-badge-success{{else}}am-badge-pending{{/if}}">
                      {{this.chosen}}/{{this.total}}
                    </span>
                  </div>
                  <div class="am-filter-pills">
                    {{#each this.options}}
                      <button type="button"
                        class="am-filter-pill {{#if this.selected}}am-pill-active{{/if}}"
                        data-action="toggleGrantOption"
                        data-grant-source="levelup"
                        data-grant-id="{{../id}}"
                        data-key="{{this.key}}">{{this.label}}</button>
                    {{/each}}
                  </div>
                </div>
              {{/each}}
              {{#each featFeatures}}
                <div class="am-grant-block">
                  <div class="am-grant-head">
                    <span class="am-grant-label">{{this.label}}</span>
                    {{#if this.total}}
                      <span class="am-counter-badge {{#if this.complete}}am-badge-success{{else}}am-badge-pending{{/if}}">
                        {{this.chosen}}/{{this.total}}
                      </span>
                    {{/if}}
                  </div>
                  <div class="am-card-grid am-inline-card-grid" role="list">
                    {{#each this.options}}
                      <button type="button" role="listitem"
                        class="am-card {{#if this.selected}}am-card-selected{{/if}}"
                        data-action="toggleGrantOption"
                        data-grant-source="levelup"
                        data-grant-id="{{../id}}"
                        data-uuid="{{this.key}}"
                        data-name="{{this.label}}"
                        data-img="{{this.img}}"
                        data-key="{{this.key}}">
                        <img class="am-card-img" src="{{this.img}}" alt="" loading="lazy">
                        <span class="am-card-name">{{this.label}}</span>
                        {{#if this.selected}}
                          <div class="am-card-meta">
                            <span class="am-known-pip"><i class="fa-solid fa-check"></i></span>
                          </div>
                        {{/if}}
                      </button>
                    {{/each}}
                  </div>
                </div>
              {{/each}}
            </div>
          {{/if}}
        {{/if}}

        {{!-- The same card grid the maneuver and spell pickers use. Feats had a
              list of their own for no reason; one shape for every choice means
              one thing to learn and one thing to style. --}}
        {{#if feats.length}}
          <div class="am-card-grid am-inline-card-grid" role="list">
            {{#each feats}}
              <button type="button"
                      class="am-card {{#if this.selected}}am-card-selected{{/if}} {{#unless this.met}}am-card-unmet{{/unless}}"
                      role="listitem"
                      data-action="luSelectFeat"
                      data-uuid="{{this.uuid}}"
                      data-name="{{this.name}}"
                      {{#if this.preText}}data-tooltip="{{this.preText}}"{{/if}}>
                <img class="am-card-img" src="{{this.img}}" alt="" loading="lazy">
                <span class="am-card-name">{{this.name}}</span>
                {{!-- The prerequisite reads on the card, not only in a tooltip:
                      an icon alone gives no reason, and a feat you cannot take
                      is worth explaining without making the player hover. --}}
                {{#if this.preText}}
                  <span class="am-card-pre {{#unless this.met}}am-card-pre-fail{{/unless}}">
                    {{#if this.unknown}}<i class="fa-solid fa-circle-question"></i>{{/if}}
                    {{this.preText}}
                  </span>
                {{/if}}
                <div class="am-card-meta">
                  {{#if this.selected}}
                    <span class="am-known-pip"><i class="fa-solid fa-check"></i></span>
                  {{/if}}
                </div>
              </button>
            {{/each}}
          </div>
          <div class="am-inline-description overflow-vert-only">
            <p class="am-hint am-inline-desc-hint">{{localize 'am.app.hover-for-description'}}</p>
          </div>
        {{else}}
          <p class="am-hint">{{localize 'am.asi.feat-none'}}</p>
        {{/if}}

        {{#if (gt featPages 1)}}
          <div class="am-feat-pager">
            <button type="button" data-action="luFeatPage" data-dir="-1" {{#unless featHasPrev}}disabled{{/unless}}>
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <span class="am-hint">{{localize 'am.asi.feat-page' page=featPage pages=featPages total=featTotal}}</span>
            <button type="button" data-action="luFeatPage" data-dir="1" {{#unless featHasNext}}disabled{{/unless}}>
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
        {{/if}}
      {{/if}}
    {{/if}}
  </section>
  {{/if}}

  {{!-- This level's grants, asked here so a5e's window never opens. Falls back to
        the heads-up note below when the builder cannot account for all of them. --}}
  {{#if hasBgGrants}}
  <hr />
  {{!-- The partial prints the heading itself; adding one here showed "Benefits"
        twice, one directly above the other. --}}
  <section class="lu-section">
    {{> am-item-grants}}
  </section>
  {{/if}}

  {{!-- What this level brings. The wording turns on whether a5e will actually
        open its window: gating it on "are there choices on this page" meant a
        level with nothing to pick still announced a window that never came. --}}
  {{#if grantsFeatures}}
  {{#unless hasBgGrants}}
  <hr />
  <section class="lu-section lu-grants-note">
    <h3><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize 'am.levelup.features-title'}}</h3>
    <p class="am-hint">
      <i class="fa-solid fa-circle-info"></i>
      {{#if grantsAbsorbed}}
        {{localize 'am.levelup.features-here'}}
      {{else}}
        {{localize 'am.levelup.features-note'}}
      {{/if}}
    </p>
    {{#if newLevelPlan}}
      {{#if newLevelPlan.features.length}}
        <div class="lu-build-chips">
          {{#each newLevelPlan.features}}
            <span class="lu-build-chip" data-uuid="{{this.uuid}}" data-name="{{this.name}}">
              {{#if this.img}}<img src="{{this.img}}" alt="">{{/if}}{{this.name}}
            </span>
          {{/each}}
        </div>
      {{/if}}
      {{#each newLevelPlan.choices}}{{> luChoice}}{{/each}}
      {{#each newLevelPlan.notes}}
        <p class="lu-build-note"><i class="fa-solid fa-wand-sparkles"></i> {{this}}</p>
      {{/each}}
      {{#unless (or newLevelPlan.features.length newLevelPlan.choices.length newLevelPlan.notes.length)}}
        <p class="am-hint">{{localize 'am.build.nothing'}}</p>
      {{/unless}}
    {{else}}
    {{#if levelCards.reading}}<p class="am-hint"><i class="fas fa-spinner fa-spin"></i> {{localize 'am.build.reading'}}</p>{{/if}}
    <ul class="lu-grants-list">
      <li><i class="fa-solid fa-check"></i> {{localize 'am.levelup.features-classfeatures'}}</li>
      {{#if info.gainsKnack}}<li><i class="fa-solid fa-check"></i> {{localize 'am.levelup.features-knack'}}</li>{{/if}}
      {{#if info.gainsASI}}<li><i class="fa-solid fa-check"></i> {{localize 'am.levelup.features-asi'}}</li>{{/if}}
      {{#if grantsTraditions}}<li><i class="fa-solid fa-check"></i> {{localize 'am.levelup.features-traditions'}}</li>{{/if}}
      {{#if deferHp}}<li><i class="fa-solid fa-check"></i> {{localize 'am.levelup.features-hp'}}</li>{{/if}}
    </ul>
    {{/if}}
  </section>
  {{/unless}}
  {{/if}}

  {{!-- Spells (level-up mode). This branch had no spell section at all, so a
        caster gaining a level could neither learn nor swap anything. --}}
  {{#if spellInfo}}
  {{> am-spell-browser}}
  {{/if}}

  {{!-- Spells this level's features let the character choose --}}
  {{> am-bonus-spells choices=bonusSpellChoices}}

  {{!-- Maneuvers (level-up mode): a section per kind taught - combat traditions and
        magic schools apart. See partial-maneuver-picker.hbs. --}}
  {{#if maneuverInfo.newManeuversToLearn}}
    {{#each maneuverSections}}{{> am-maneuver-picker}}{{/each}}
  {{/if}}

  {{> luAhead}}

  {{/if}}{{!-- /mode toggle --}}

  <hr />

  {{!-- Footer --}}
  <div class="lu-footer flex justify-between items-center">
    <button type="button" class="lu-cancel" data-action="luCancel">
      {{localize 'am.app.cancel'}}
    </button>
    {{#if (eq mode 'build')}}
    {{!-- A past level is changed with its own buttons above; nothing to submit here --}}
    {{else if (eq mode 'leveldown')}}
    <button type="button" data-action="luApplyLevelDown" class="am-footer-submit lu-submit lu-down-submit"
      {{#unless down}}disabled{{/unless}}>
      <i class="fa-solid {{#if down.rebuild}}fa-rotate{{else}}fa-arrow-down{{/if}}"></i>
      {{down.submit}}
    </button>
    {{else}}
    <button type="submit" data-action="submit" class="am-footer-submit lu-submit">
      {{#if (eq mode 'multiclass')}}
        <i class="fa-solid fa-code-branch"></i>
        {{localize 'am.levelup.multiclass-submit'}}
      {{else}}
        <i class="fa-solid fa-arrow-up"></i>
        {{localize 'am.levelup.submit'}}
      {{/if}}
    </button>
    {{/if}}
  </div>

  </div>{{!-- /lu-main --}}
</div>
