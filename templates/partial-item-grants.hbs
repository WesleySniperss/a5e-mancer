{{!-- Grant choices for an origin item (heritage / culture / background / destiny),
      asked here so a5e's own "Apply Grants" window never opens for it.
      Rendered only when the builder can account for every grant on the item;
      otherwise a5e still handles them and this block stays hidden. --}}
{{#if hasBgGrants}}
  <hr />
  <h3><i class="fa-solid fa-award"></i> {{localize 'am.grants.item-title'}}</h3>
  <p class="am-hint">{{localize 'am.grants.background-hint'}}</p>

  {{#each bgGrants}}
    <div class="am-grant-block">
      <div class="am-grant-head">
        <span class="am-grant-label">{{this.label}}</span>
        <span class="am-counter-badge {{#if this.complete}}am-badge-success{{else}}am-badge-pending{{/if}}">
          {{this.chosen}}/{{this.total}}
        </span>
      </div>
      {{#if this.baseLabels.length}}
        <p class="am-hint">{{localize 'am.grants.always-granted'}}: {{#each this.baseLabels}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
      {{/if}}
      <div class="am-filter-pills">
        {{#each this.options}}
          <button type="button"
            class="am-filter-pill {{#if this.selected}}am-pill-active{{/if}}"
            data-action="toggleGrantOption"
            data-grant-source="{{../grantType}}"
            data-grant-id="{{../id}}"
            data-key="{{this.key}}">{{this.label}}</button>
        {{/each}}
      </div>
    </div>
  {{/each}}

  {{#each bgFeatures}}
    <div class="am-grant-block">
      <div class="am-grant-head">
        <span class="am-grant-label">{{this.label}}</span>
        {{#if this.total}}
          <span class="am-counter-badge {{#if this.complete}}am-badge-success{{else}}am-badge-pending{{/if}}">
            {{this.chosen}}/{{this.total}}
          </span>
        {{/if}}
      </div>
      {{!-- Always granted. One per row rather than a comma list so each carries a
            name worth right-clicking; the description opens in the shared panel,
            the same gesture as everywhere else in the module. --}}
      {{#if this.baseEntries.length}}
        <p class="am-hint">{{localize 'am.grants.always-granted'}}:</p>
        <div class="am-feature-rows">
          {{#each this.baseEntries}}
            <div class="am-feature-row am-feature-granted"
                 data-uuid="{{this.key}}" data-name="{{this.label}}">
              <div class="am-feature-head">
                <i class="fa-solid fa-check am-feature-tick"></i>
                <span class="am-feature-name">{{this.label}}</span>
              </div>
            </div>
          {{/each}}
        </div>
      {{/if}}

      {{#if this.options.length}}
        <div class="am-feature-rows">
          {{#each this.options}}
            <div class="am-feature-row {{#if this.selected}}am-feature-selected{{/if}}"
                 data-uuid="{{this.key}}" data-name="{{this.label}}">
              <div class="am-feature-head">
                <button type="button"
                  class="am-feature-pick"
                  data-action="toggleGrantOption"
                  data-grant-source="{{../grantType}}"
                  data-grant-id="{{../id}}"
                  data-key="{{this.key}}">
                  <i class="fa-solid {{#if this.selected}}fa-square-check{{else}}fa-square{{/if}}"></i>
                  <span class="am-feature-name">{{this.label}}</span>
                </button>
              </div>
            </div>
          {{/each}}
        </div>
      {{/if}}
    </div>
  {{/each}}
{{/if}}
