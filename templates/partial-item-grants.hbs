{{!-- Grant choices for an origin item (heritage / culture / background / destiny),
      asked here so a5e's own "Apply Grants" window never opens for it.
      Rendered only when the builder can account for every grant on the item;
      otherwise a5e still handles them and this block stays hidden. --}}
{{#if hasBgGrants}}
  <hr />
  <h3><i class="fa-solid fa-award"></i> {{localize 'am.grants.item-title'}}</h3>
  <p class="am-hint">{{localize 'am.grants.background-hint'}}</p>

  {{#each bgGrants}}
    <div class="am-grant-block">
      <div class="am-grant-head">
        <span class="am-grant-label">{{this.label}}</span>
        <span class="am-counter-badge {{#if this.complete}}am-badge-success{{else}}am-badge-pending{{/if}}">
          {{this.chosen}}/{{this.total}}
        </span>
      </div>
      {{#if this.baseLabels.length}}
        <p class="am-hint">{{localize 'am.grants.always-granted'}}: {{#each this.baseLabels}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
      {{/if}}
      <div class="am-filter-pills">
        {{#each this.options}}
          {{!-- `duplicate` means the character already has it, from themselves or from
                another choice in this build, so picking it would gain nothing. --}}
          <button type="button"
            class="am-filter-pill {{#if this.selected}}am-pill-active{{/if}} {{#if this.duplicate}}am-pill-duplicate{{/if}}"
            {{#if this.duplicate}}disabled aria-disabled="true"{{/if}}
            data-action="toggleGrantOption"
            data-grant-source="{{../grantType}}"
            data-grant-id="{{../id}}"
            {{#if this.duplicate}}data-tooltip="{{localize 'am.grants.duplicate-hint'}}"{{/if}}
            data-key="{{this.key}}">{{this.label}}{{#if this.duplicate}} <i class="fa-solid fa-clone"></i>{{/if}}</button>
        {{/each}}
      </div>
    </div>
  {{/each}}

  {{#each bgFeatures}}
    <div class="am-grant-block">
      <div class="am-grant-head">
        <span class="am-grant-label">{{this.label}}</span>
        {{#if this.total}}
          <span class="am-counter-badge {{#if this.complete}}am-badge-success{{else}}am-badge-pending{{/if}}">
            {{this.chosen}}/{{this.total}}
          </span>
        {{/if}}
      </div>
      {{!-- The same card grid the maneuver, spell and feat pickers use, so every
            choice in the module looks and behaves alike. Right-click any card
            for its full text. --}}
      {{#if this.baseEntries.length}}
        <p class="am-hint">{{localize 'am.grants.always-granted'}}:</p>
        <div class="am-card-grid am-inline-card-grid" role="list">
          {{#each this.baseEntries}}
            <div class="am-card am-card-granted" role="listitem"
                 data-uuid="{{this.key}}" data-name="{{this.label}}" data-img="{{this.img}}">
              <img class="am-card-img" src="{{this.img}}" alt="" loading="lazy">
              <span class="am-card-name">{{this.label}}</span>
              <div class="am-card-meta">
                <span class="am-known-pip"><i class="fa-solid fa-check"></i></span>
                {{#if this.asksInProse}}
                  {{!-- a5e states this choice in the text and records it nowhere,
                        so nothing can ask for it. Say so rather than let it pass. --}}
                  <span class="am-feature-manual"
                        data-tooltip="{{localize 'am.grants.manual-choice-hint'}}">
                    <i class="fa-solid fa-hand-pointer"></i>
                  </span>
                {{/if}}
              </div>
            </div>
          {{/each}}
        </div>
      {{/if}}

      {{#if this.options.length}}
        <div class="am-card-grid am-inline-card-grid" role="list">
          {{#each this.options}}
            <button type="button" role="listitem"
              class="am-card {{#if this.selected}}am-card-selected{{/if}}"
              data-action="toggleGrantOption"
              data-grant-source="{{../grantType}}"
              data-grant-id="{{../id}}"
              data-uuid="{{this.key}}"
              data-name="{{this.label}}"
              data-img="{{this.img}}"
              data-key="{{this.key}}">
              <img class="am-card-img" src="{{this.img}}" alt="" loading="lazy">
              <span class="am-card-name">{{this.label}}</span>
              {{#if this.selected}}
                <div class="am-card-meta">
                  <span class="am-known-pip"><i class="fa-solid fa-check"></i></span>
                </div>
              {{/if}}
            </button>
          {{/each}}
        </div>
      {{/if}}
    </div>
  {{/each}}
{{/if}}
