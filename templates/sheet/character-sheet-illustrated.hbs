{{!--
  Illustrated sheet — the fields, laid over the artwork.

  Every block is positioned in PER CENT of the page, never in pixels, so the
  overlay tracks the picture at any window size. The page itself is held at the
  artwork's aspect ratio by CSS, which is what keeps the two in register: fix
  the ratio once and every percentage below stays true.

  Each block carries `data-slot`, and the coordinates live in the stylesheet
  rather than here. That is deliberate — nudging a field a few per cent is the
  work this design will need most, and it should not mean touching markup.
--}}
<div class="am-ill-page">

  {{!-- The artwork. An <img> rather than a background so it prints, and so a
        missing file is visible instead of silently blank. --}}
  <img class="am-ill-art" src="modules/a5e-mancer/assets/sheet/frame.jpg" alt="" />

  {{!-- ─────────────────────────── identity ─────────────────────────── --}}
  <div class="am-ill" data-slot="name">
    <input type="text" name="name" value="{{actor.name}}" />
  </div>

  <div class="am-ill" data-slot="class-level">{{charInfo.classLine}}</div>
  <div class="am-ill" data-slot="background">{{bio.background}}</div>
  <div class="am-ill" data-slot="player">{{charInfo.player}}</div>
  <div class="am-ill" data-slot="race">{{charInfo.heritage}}</div>
  <div class="am-ill" data-slot="alignment">{{bio.alignment}}</div>
  <div class="am-ill" data-slot="xp">{{charInfo.xp}}</div>

  {{!-- ─────────────────────────── top badges ───────────────────────── --}}
  <div class="am-ill am-ill-num" data-slot="inspiration">
    <button type="button" data-action="toggle-inspiration">{{#if resources.inspiration}}1{{else}}0{{/if}}</button>
  </div>
  <div class="am-ill am-ill-num" data-slot="prof-bonus">{{resources.profBonus}}</div>
  <div class="am-ill am-ill-num" data-slot="ac">
    <input type="number" id="am-ac-input" value="{{resources.ac}}" />
  </div>

  {{!-- ─────────────────────────── abilities ────────────────────────── --}}
  {{#each abilities}}
    <div class="am-ill am-ill-abl" data-slot="abl-{{this.key}}">
      <button type="button" class="am-ill-abl-mod"
        data-action="ability-check" data-ability="{{this.key}}"
        data-mod="{{this.mod}}" data-label="{{this.label}} Check">{{this.modStr}}</button>
      <input class="am-ill-abl-score" type="number"
        name="system.abilities.{{this.key}}.value" value="{{this.value}}" min="1" max="30" />
    </div>
  {{/each}}

  {{!-- ─────────────────────────── saving throws ────────────────────── --}}
  <div class="am-ill am-ill-list" data-slot="saves">
    {{#each savingThrows}}
      <div class="am-ill-row">
        <span class="am-cs-prof-dot am-cs-prof-{{this.profLvl}}"></span>
        <button type="button" data-action="save-roll" data-ability="{{this.key}}"
          data-label="{{this.label}}" data-bonus="{{this.bonus}}">{{this.label}}</button>
        <span class="am-ill-bonus">{{this.bonusStr}}</span>
      </div>
    {{/each}}
  </div>

  {{!-- ─────────────────────────── skills ───────────────────────────── --}}
  <div class="am-ill am-ill-list" data-slot="skills">
    {{#each skills}}
      <div class="am-ill-row">
        <span class="am-cs-prof-dot am-cs-prof-{{this.profLvl}}" title="{{this.profIcon}}"></span>
        <button type="button" data-action="skill-check" data-skill="{{this.key}}"
          data-label="{{this.label}}" data-bonus="{{this.bonus}}">{{this.label}}</button>
        <span class="am-ill-abl">{{this.ability}}</span>
        <span class="am-ill-bonus">{{this.bonusStr}}</span>
      </div>
    {{/each}}
  </div>

  <div class="am-ill am-ill-num" data-slot="passive">{{passivePerception}}</div>
  <div class="am-ill am-ill-num" data-slot="speed">{{resources.speed}}</div>

  {{!-- ───────────────── a5e's own, which the artwork has no box for ──
        Exertion, fatigue and strife have nowhere to live on a 5e sheet. They
        sit in a strip of their own until the art gains a frame for them —
        visible and usable rather than quietly dropped. --}}
  <div class="am-ill am-ill-a5e" data-slot="a5e-strip">
    <span class="am-ill-a5e-item">EXERTION
      <input type="number" id="am-exertion-current" value="{{resources.exertion.current}}" min="0" />
      / {{resources.exertion.max}}</span>
    <span class="am-ill-a5e-item">FATIGUE {{resources.fatigue}}</span>
    <span class="am-ill-a5e-item">STRIFE {{resources.strife}}</span>
    {{#if maneuverDC}}<span class="am-ill-a5e-item">MANEUVER DC {{maneuverDC}}</span>{{/if}}
  </div>

  {{!-- ─────────────────────────── hit points ───────────────────────── --}}
  <div class="am-ill am-ill-num" data-slot="hit-dice">{{charInfo.hitDice}}</div>
  <div class="am-ill am-ill-num" data-slot="hp-max">
    <input type="number" id="am-hp-max" value="{{resources.hp.max}}" />
  </div>
  <div class="am-ill am-ill-num" data-slot="hp-current">
    <input type="number" id="am-hp-current" value="{{resources.hp.value}}" min="0" />
  </div>
  <div class="am-ill am-ill-num" data-slot="hp-temp">
    <input type="number" id="am-hp-temp" value="{{resources.hp.temp}}" min="0" placeholder="0" />
  </div>

  {{!-- ─────────────────────────── attacks ──────────────────────────── --}}
  <div class="am-ill am-ill-list" data-slot="attacks">
    {{#each weapons}}
      <div class="am-ill-row">
        <button type="button" data-action="weapon-attack" data-id="{{this.id}}">{{this.name}}</button>
        <span class="am-ill-bonus">{{this.attackStr}}</span>
        <span class="am-ill-dmg">{{this.damage}}</span>
      </div>
    {{/each}}
  </div>

  {{!-- ─────────────────────────── proficiencies ────────────────────── --}}
  <div class="am-ill am-ill-prose" data-slot="proficiencies">{{proficiencies.summary}}</div>

  {{!-- ─────────────────────────── features ─────────────────────────── --}}
  <div class="am-ill am-ill-list" data-slot="features">
    {{#each allFeatures}}
      <div class="am-ill-row am-ill-feature">
        <button type="button" data-action="feature-open" data-id="{{this.id}}">{{this.name}}</button>
      </div>
    {{/each}}
  </div>

</div>
