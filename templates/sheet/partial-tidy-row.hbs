{{!-- ───────────────────────────────────────────────────────────────────────
     One row of a Tidy item table.

     The element shape is Tidy's TidyItemTableRow: a .tidy-table-row-container
     holding a .tidy-table-row, whose first children are the use button and the
     primary name cell, followed by state icons, the value cells and the
     actions cell. Reproduced so tidy/quadrone.css lays it out.

     data-item-id sits on the container, which is where Tidy puts it too, so
     activateListeners finds rows by .tidy-table-row-container[data-item-id]
     for drag, edit and the description panel. The use button carries our own
     data-action rather than Tidy's, so the click reaches our handler.

     COLUMNS. The c1/c2/c3/showUses/showQty flags MUST match the ones given to
     tidy-table for the same section: a row that renders fewer cells than the
     header pushes every later column out of line, which is what made the
     tables look crooked. Each declared cell renders whether or not this item
     has a value — an empty cell still holds its column open.

     The state icons deliberately sit inside the flexible name column, exactly
     as Tidy has them, so a row carrying more icons than its neighbour still
     lines up down the right-hand side.
     ─────────────────────────────────────────────────────────────────────── --}}
{{!-- data-activation carries how the thing is used — action, bonus action,
     reaction, or absent for something passive. The Features tab filters on
     it in the DOM, so it has to be on the row rather than only in the cell
     text, which is localised and would be matched by its spelling. --}}
<div class="tidy-table-row-container" data-item-id="{{id}}"
  data-document-uuid="{{uuid}}"{{#if activation}} data-activation="{{activation}}"{{/if}}>
  <div
    class="tidy-table-row tidy-table-row-v2{{#if equipped}} equipped{{/if}}{{#if attuneProblem}} attunement-problem{{/if}}{{#if alwaysPrepared}} am-always-prepared{{else if preparedOnly}} am-prepared{{/if}}"
    data-tidy-table-row data-tidy-draggable data-tidy-item-type="{{type}}">

    <div class="highlight"></div>

    {{!-- The NPC statblock lists an item’s actions separately — a bite and a
          breath weapon can live on one feature — so it passes useAction and
          the id of the action to fire. Everything else leaves both unset and
          gets the plain item-use it always had. --}}
    <a class="tidy-table-row-use-button"
      data-action="{{#if useAction}}{{useAction}}{{else}}item-use{{/if}}"
      data-id="{{id}}"{{#if actionId}} data-action-id="{{actionId}}"{{/if}}
      aria-label="Use {{name}}"
      data-tooltip="Use — right-click to skip the dialog">
      <img class="item-image" src="{{img}}" alt="{{name}}" />
      <span class="roll-prompt"><i class="fa-solid fa-dice-d20"></i></span>
    </a>

    <div class="tidy-table-cell primary item-label text-cell">
      <a class="item-name" role="button" tabindex="0">
        <span class="cell-text">
          <span class="cell-name">{{name}}</span>
          {{#if subtitle}}<span class="cell-context">{{subtitle}}</span>{{/if}}
        </span>
        <span class="row-detail-expand-indicator collapsed">
          <i class="fa-solid fa-angle-right expand-indicator"></i>
        </span>
      </a>

      {{!-- State icons, in Tidy's order: marks, then attunement, then equipped.
            A5e adds damaged and broken, which have no Tidy equivalent, so they
            borrow its item-state-indicator styling. --}}
      <span class="am-state-icons">
        {{!-- Concentration and ritual as a5e abbreviates them, C and R
             (A5E.spells.concentrationAbbr, ritualAbbr): a letter beside the
             name reads faster than a glyph and takes less room, and beside
             the name it stays when narrow columns are hidden. --}}
        {{#if concentration}}
          <span class="am-mark am-mark-conc item-state-indicator" data-tooltip="Concentration">C</span>
        {{/if}}
        {{!-- Magic. a5e says so through rarity, and the rarity is worth
             naming in the tooltip because "legendary" and "common" are not
             the same news about an item. --}}
        {{#if magical}}
          <i class="fa-solid fa-sparkles item-state-indicator am-magical am-rarity-{{rarity}}"
            data-tooltip="{{#if rarityLabel}}{{rarityLabel}}{{else}}Magical{{/if}}"></i>
        {{/if}}

        {{#if ritual}}
          <span class="am-mark am-mark-ritual item-state-indicator" data-tooltip="Ritual">R</span>
        {{/if}}
        {{!-- A spell's prepared state, as a5e's sheet shows it: a book, lit
              when prepared, with sparkles when always prepared. Cycles on
              click. In a spell table it is a button among the row's own,
              where a5e puts it (prepCol); elsewhere — a starred spell on
              Favorites — it stays a state icon, so that table's columns
              keep their widths. --}}
        {{#if preparable}}{{#unless prepCol}}
          <button type="button" data-action="item-prepare" data-id="{{id}}"
            class="unbutton item-state-indicator"
            aria-label="Prepared state: {{preparedLabel}}" data-tooltip="{{preparedLabel}}">
            <i class="fa-solid {{preparedIcon}} {{#if prepared}}color-icon-theme-highlight highlighted{{else}}color-text-lightest{{/if}}"></i>
          </button>
        {{/unless}}{{/if}}
        {{#if needsAttune}}
          <button type="button" data-action="item-attune" data-id="{{id}}"
            class="unbutton item-state-indicator"
            data-tooltip="{{#if attuned}}Attuned{{else}}Requires attunement{{/if}}">
            <i class="{{#if attuned}}fa-solid fa-sun color-icon-theme-highlight highlighted{{else}}fa-regular fa-sun color-text-lightest{{/if}}"></i>
          </button>
        {{/if}}
        {{!-- Both of these are three-state in a5e, and both cycle on click.
              The icon IS the state — see #stateBadges for the mapping. The
              equip control is hidden for anything inside a container, as it
              is on a5e's own sheet. --}}
        {{#if isEquippable}}
          {{#unless inContainer}}
            <button type="button" data-action="item-equip" data-id="{{id}}"
              class="unbutton item-state-indicator"
              aria-label="Equipped state: {{equipLabel}}" data-tooltip="{{equipLabel}}">
              <i class="fa-solid {{equipIcon}} {{#if equipActive}}color-icon-theme-highlight highlighted{{else}}color-text-lightest{{/if}}"></i>
            </button>
          {{/unless}}
          <button type="button" data-action="item-damaged" data-id="{{id}}"
            class="unbutton item-state-indicator"
            aria-label="Condition: {{damagedLabel}}" data-tooltip="{{damagedLabel}}">
            <i class="fa-solid {{damagedIcon}} {{#if damagedActive}}color-icon-theme-highlight highlighted{{else}}color-text-lightest{{/if}}"></i>
          </button>
        {{/if}}
      </span>
    </div>

    {{!-- Value cells — see the COLUMNS note above. --}}
    {{#if showUses}}
      <div class="tidy-table-cell uses-cell"
        style="--tidy-table-column-width: var(--am-col-uses)">
        {{#if uses.hasUses}}
          <input type="number" class="uninput uses-value" data-action="item-uses"
            data-id="{{id}}" value="{{uses.current}}" min="0" max="{{uses.max}}"
            aria-label="Uses remaining" />
          <span class="separator">/</span>
          <span class="uses-max color-text-lighter">{{uses.max}}</span>
        {{/if}}
      </div>
    {{/if}}
    {{#if showQty}}
      <div class="tidy-table-cell quantity-cell"
        style="--tidy-table-column-width: var(--am-col-narrow)">
        <input type="number" class="uninput" data-action="item-qty" data-id="{{id}}"
          value="{{qty}}" min="0" aria-label="Quantity" />
      </div>
    {{/if}}
    {{!-- wN and hN as in tidy-table, and must match it. tipN is the long
         form behind a short cell; iconN a glyph after it (an area's shape). An empty cell
         still holds its column open, and shows Tidy's dash when dash is set. --}}
    {{#if c1}}
      <div class="tidy-table-cell text-cell{{#if h1}} {{h1}}{{/if}}"
        style="--tidy-table-column-width: {{#if w1}}{{w1}}{{else}}var(--am-col){{/if}}"{{#if tip1}} data-tooltip="{{tip1}}"{{/if}}>
        <span class="cell-text">{{#if cell1}}{{cell1}}{{else if dash}}<span class="color-text-disabled">—</span>{{/if}}</span>{{#if icon1}}<i class="{{icon1}} am-cell-icon"></i>{{/if}}
      </div>
    {{/if}}
    {{#if c2}}
      <div class="tidy-table-cell text-cell {{#if h2}}{{h2}}{{else}}hide-under-500{{/if}}"
        style="--tidy-table-column-width: {{#if w2}}{{w2}}{{else}}var(--am-col){{/if}}"{{#if tip2}} data-tooltip="{{tip2}}"{{/if}}>
        <span class="cell-text">{{#if cell2}}{{cell2}}{{else if dash}}<span class="color-text-disabled">—</span>{{/if}}</span>{{#if icon2}}<i class="{{icon2}} am-cell-icon"></i>{{/if}}
      </div>
    {{/if}}
    {{#if c3}}
      <div class="tidy-table-cell text-cell {{#if h3}}{{h3}}{{else}}hide-under-600{{/if}}"
        style="--tidy-table-column-width: {{#if w3}}{{w3}}{{else}}var(--am-col){{/if}}"{{#if tip3}} data-tooltip="{{tip3}}"{{/if}}>
        <span class="cell-text">{{#if cell3}}{{cell3}}{{else if dash}}<span class="color-text-disabled">—</span>{{/if}}</span>{{#if icon3}}<i class="{{icon3}} am-cell-icon"></i>{{/if}}
      </div>
    {{/if}}
    {{#if c4}}
      <div class="tidy-table-cell text-cell {{#if h4}}{{h4}}{{else}}hide-under-600{{/if}}"
        style="--tidy-table-column-width: {{#if w4}}{{w4}}{{else}}var(--am-col){{/if}}"{{#if tip4}} data-tooltip="{{tip4}}"{{/if}}>
        <span class="cell-text">{{#if cell4}}{{cell4}}{{else if dash}}<span class="color-text-disabled">—</span>{{/if}}</span>{{#if icon4}}<i class="{{icon4}} am-cell-icon"></i>{{/if}}
      </div>
    {{/if}}
    {{#if c5}}
      <div class="tidy-table-cell text-cell {{#if h5}}{{h5}}{{else}}hide-under-600{{/if}}"
        style="--tidy-table-column-width: {{#if w5}}{{w5}}{{else}}var(--am-col){{/if}}"{{#if tip5}} data-tooltip="{{tip5}}"{{/if}}>
        <span class="cell-text">{{#if cell5}}{{cell5}}{{else if dash}}<span class="color-text-disabled">—</span>{{/if}}</span>{{#if icon5}}<i class="{{icon5}} am-cell-icon"></i>{{/if}}
      </div>
    {{/if}}

    <div class="tidy-table-cell header-cell-actions row-actions"
      style="--tidy-table-column-width: {{#if prepCol}}calc({{#if @root.unlocked}}var(--am-col-actions){{else}}var(--am-col-actions-locked){{/if}} + var(--am-col-prep)){{else}}{{#if @root.unlocked}}var(--am-col-actions){{else}}var(--am-col-actions-locked){{/if}}{{/if}}">
      {{#if prepCol}}{{#if preparable}}
        <button type="button" class="button button-borderless button-icon-only am-prepare am-prepare-{{preparedState}}"
          data-action="item-prepare" data-id="{{id}}"
          aria-label="Prepared state: {{preparedLabel}}"
          data-tooltip="{{preparedLabel}} — click to change">
          <i class="fa-solid {{preparedIcon}}"></i>
        </button>
      {{/if}}{{/if}}
      <button type="button" class="button button-borderless button-icon-only"
        data-action="item-star" data-id="{{id}}"
        data-tooltip="{{#if starred}}Remove from favorites{{else}}Add to favorites{{/if}}">
        <i class="{{#if starred}}fa-solid{{else}}fa-regular{{/if}} fa-star"></i>
      </button>
      <button type="button" class="button button-borderless button-icon-only"
        data-action="item-chat" data-id="{{id}}" data-tooltip="Send to Chat">
        <i class="fa-solid fa-comment"></i>
      </button>
      {{!-- Editing and deleting appear only when the sheet is unlocked, as on
           a5e own. Starring and sending to chat stay: neither changes the
           item, and both are things done constantly in play.

           @root reaches past the row context, which is one item and knows
           nothing about the sheet it is on. --}}
      {{#if @root.unlocked}}
        <button type="button" class="button button-borderless button-icon-only"
          data-action="item-edit" data-id="{{id}}" data-tooltip="Edit">
          <i class="fa-solid fa-pen"></i>
        </button>
        <button type="button" class="button button-borderless button-icon-only"
          data-action="item-delete" data-id="{{id}}" data-tooltip="Delete">
          <i class="fa-solid fa-trash"></i>
        </button>
      {{/if}}
    </div>
  </div>

  {{!-- The summary, collapsed until the name is clicked. This is where an
        item description and its actions belong — in Tidy the actions are a
        NESTED table in here, never loose rows in the parent table, which is
        what kept our columns from lining up. --}}
  <div class="expandable" role="presentation">
    <div class="expandable-child-animation-wrapper" role="presentation">

      {{#if desc}}
        <div class="editor-rendered-content">
          <div class="user-select-text">{{{desc}}}</div>
        </div>
      {{/if}}

      {{#if actions.length}}
        <section class="tidy-table inline-activities-table">
          <header class="tidy-table-header-row no-background">
            <div class="tidy-table-header-cell primary header-label-cell"><h3>Actions</h3></div>
            <div class="tidy-table-header-cell"
              style="--tidy-table-column-width: var(--am-col)">Cost</div>
            <div class="tidy-table-header-cell"
              style="--tidy-table-column-width: var(--am-col)">Attack</div>
            <div class="tidy-table-header-cell"
              style="--tidy-table-column-width: var(--am-col)">Damage</div>
          </header>
          <div class="item-table-body">
            {{#each actions}}
              <div class="tidy-table-row-container"
                data-item-id="{{this.itemId}}" data-action-id="{{this.actionId}}">
                <div class="tidy-table-row tidy-table-row-v2 activity"
                  data-tidy-table-row data-item-id="{{this.itemId}}"
                  data-action-id="{{this.actionId}}">
                  <a class="tidy-table-row-use-button" data-action="item-action-use"
                    data-id="{{this.itemId}}" data-action-id="{{this.actionId}}"
                    aria-label="Use {{this.name}}"
                    data-tooltip="Use — right-click to skip the dialog">
                    <img class="item-image" src="{{this.img}}" alt="{{this.name}}" />
                    <span class="roll-prompt"><i class="fa-solid fa-dice-d20"></i></span>
                  </a>
                  <div class="tidy-table-cell primary item-label text-cell">
                    <span class="cell-text">
                      <span class="cell-name">{{this.name}}</span>
                      {{#if this.desc}}<span class="cell-context">{{this.desc}}</span>{{/if}}
                    </span>
                  </div>
                  <div class="tidy-table-cell text-cell"
                    style="--tidy-table-column-width: var(--am-col)">
                    <span class="cell-text">{{this.activationLabel}}</span>
                  </div>
                  {{!-- Each figure rolls only itself: the attack rolls to hit,
                        the damage rolls damage. The icon at the front still
                        does the whole thing through a5e, which is the common
                        case; these are for when only one half is wanted. --}}
                  <div class="tidy-table-cell text-cell"
                    style="--tidy-table-column-width: var(--am-col)">
                    {{#if this.atkBonus}}
                      <button type="button" class="unbutton am-part-roll"
                        data-action="roll-attack" data-bonus="{{this.atkBonus}}"
                        data-label="{{this.name}}"
                        data-tooltip="Roll to hit only">
                        <span class="cell-text">{{this.atkBonus}}</span>
                      </button>
                    {{/if}}
                  </div>
                  <div class="tidy-table-cell text-cell"
                    style="--tidy-table-column-width: var(--am-col)">
                    {{#if this.dmg}}
                      <button type="button" class="unbutton am-part-roll"
                        data-action="roll-damage" data-formula="{{this.dmg}}"
                        data-label="{{this.name}}{{#if this.dmgType}} ({{this.dmgType}}){{/if}}"
                        data-tooltip="Roll damage only">
                        <span class="cell-text">{{this.dmgFull}}</span>
                      </button>
                    {{else}}
                      <span class="cell-text">{{this.dmgFull}}</span>
                    {{/if}}
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
        </section>
      {{/if}}

      {{#if contents.length}}
        <section class="tidy-table inline-activities-table">
          <header class="tidy-table-header-row no-background">
            <div class="tidy-table-header-cell primary header-label-cell"><h3>Contents</h3></div>
            <div class="tidy-table-header-cell"
              style="--tidy-table-column-width: var(--am-col-narrow)">Qty</div>
            <div class="tidy-table-header-cell"
              style="--tidy-table-column-width: var(--am-col)">Weight</div>
          </header>
          <div class="item-table-body">
            {{#each contents}}
              <div class="tidy-table-row-container" data-item-id="{{this.id}}"
                data-document-uuid="{{this.uuid}}">
                <div class="tidy-table-row tidy-table-row-v2" data-tidy-table-row>
                  <a class="tidy-table-row-use-button" data-action="item-use"
                    data-id="{{this.id}}" aria-label="Use {{this.name}}">
                    <img class="item-image" src="{{this.img}}" alt="{{this.name}}" />
                    <span class="roll-prompt"><i class="fa-solid fa-dice-d20"></i></span>
                  </a>
                  <div class="tidy-table-cell primary item-label text-cell">
                    <span class="cell-text"><span class="cell-name">{{this.name}}</span></span>
                    {{!-- Contents of a container are drawn by this block rather
                         than by the row above, so they carried none of its state
                         icons. A magic item does not stop being one for having
                         been put in a bag. --}}
                    {{#if this.magical}}
                      <i class="fa-solid fa-sparkles item-state-indicator am-magical am-rarity-{{this.rarity}}"
                        data-tooltip="{{#if this.rarityLabel}}{{this.rarityLabel}}{{else}}Magical{{/if}}"></i>
                    {{/if}}
                  </div>
                  <div class="tidy-table-cell text-cell"
                    style="--tidy-table-column-width: var(--am-col-narrow)">
                    <span class="cell-text">{{this.qty}}</span>
                  </div>
                  <div class="tidy-table-cell text-cell"
                    style="--tidy-table-column-width: var(--am-col)">
                    <span class="cell-text">{{this.weight}}</span>
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
        </section>
      {{/if}}

      {{!-- Costs and requirements a5e keeps and dnd5e has no column for. --}}
      {{#if summaryTags.length}}
        <div class="inline-wrapped-elements user-select-text">
          <div class="left-aligned-elements">
            {{#each summaryTags}}
              <span class="tag"><span class="value">{{this}}</span></span>
            {{/each}}
          </div>
        </div>
      {{/if}}
    </div>
  </div>
</div>
